# URL del backend de UNIFRANZ (sin barra final).
VITE_API_BASE_URL=http://localhost:3000

# true: respuestas de prueba locales, claramente identificadas en la interfaz.
# false: usa el backend real en VITE_API_BASE_URL.
# Para la demostración sin backend, deja true. Para la integración real, cambia a false.
VITE_USE_MOCK=true
